# ==============================================================================
# Trace — .gitattributes
#
# Two jobs:
#   1. Route every binary type an Unreal project accumulates through Git LFS.
#   2. Force deterministic LF line endings on all text, so a Windows and a macOS
#      developer never produce a whole-file diff by opening the same file.
#
# LFS setup for a fresh clone:      ./Scripts/setup-lfs.sh
#
# Patterns are case-sensitive on case-sensitive filesystems (Linux CI, APFS
# volumes formatted case-sensitive). Uppercase duplicates are listed for the
# extensions that DCC tools most often emit in caps (.PNG from some exporters,
# .TGA / .FBX from older Max/Maya pipelines).
#
# `lockable` is set on the merge-hostile Unreal formats (.uasset/.umap/.fbx).
# Those files cannot be merged — two people editing one is always data loss —
# so the workflow is:
#     git lfs lock   Content/Maps/Arena.umap
#     ... edit, commit, push ...
#     git lfs unlock Content/Maps/Arena.umap
# `git lfs locks` lists who holds what. Locked files are checked out read-only
# for everyone else, which is the point: the OS stops you before Git has to.
# ==============================================================================

# ------------------------------------------------------------------------------
# Default: let Git decide, but normalise anything it detects as text to LF in
# the repository. Explicit rules below override this.
# ------------------------------------------------------------------------------
* text=auto eol=lf

# ------------------------------------------------------------------------------
# Unreal binary asset formats — LFS + lockable
# ------------------------------------------------------------------------------
*.uasset  filter=lfs diff=lfs merge=lfs -text lockable
*.umap    filter=lfs diff=lfs merge=lfs -text lockable
*.UASSET  filter=lfs diff=lfs merge=lfs -text lockable
*.UMAP    filter=lfs diff=lfs merge=lfs -text lockable
*.ubulk   filter=lfs diff=lfs merge=lfs -text
*.uexp    filter=lfs diff=lfs merge=lfs -text
*.uptnl   filter=lfs diff=lfs merge=lfs -text
*.udk     filter=lfs diff=lfs merge=lfs -text
*.upk     filter=lfs diff=lfs merge=lfs -text

# ------------------------------------------------------------------------------
# 3D / DCC source files — LFS, and lockable for the ones artists co-edit
# ------------------------------------------------------------------------------
*.fbx     filter=lfs diff=lfs merge=lfs -text lockable
*.FBX     filter=lfs diff=lfs merge=lfs -text lockable
*.obj     filter=lfs diff=lfs merge=lfs -text
*.3ds     filter=lfs diff=lfs merge=lfs -text
*.abc     filter=lfs diff=lfs merge=lfs -text
*.blend   filter=lfs diff=lfs merge=lfs -text lockable
*.ma      filter=lfs diff=lfs merge=lfs -text lockable
*.mb      filter=lfs diff=lfs merge=lfs -text lockable
*.max     filter=lfs diff=lfs merge=lfs -text lockable
*.dae     filter=lfs diff=lfs merge=lfs -text
*.glb     filter=lfs diff=lfs merge=lfs -text
*.gltf    filter=lfs diff=lfs merge=lfs -text

