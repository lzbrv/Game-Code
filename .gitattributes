*.zip     filter=lfs diff=lfs merge=lfs -text
*.7z      filter=lfs diff=lfs merge=lfs -text
*.rar     filter=lfs diff=lfs merge=lfs -text
*.gz      filter=lfs diff=lfs merge=lfs -text
*.tgz     filter=lfs diff=lfs merge=lfs -text
*.bz2     filter=lfs diff=lfs merge=lfs -text
*.xz      filter=lfs diff=lfs merge=lfs -text

# ==============================================================================
# Text — explicit normalisation. Everything here is diffable and mergeable.
# ==============================================================================

# C++ / C# source and build scripts
*.h       text eol=lf diff=cpp
*.hpp     text eol=lf diff=cpp
*.inl     text eol=lf diff=cpp
*.c       text eol=lf diff=cpp
*.cc      text eol=lf diff=cpp
*.cpp     text eol=lf diff=cpp
*.cs      text eol=lf diff=csharp
*.usf     text eol=lf
*.ush     text eol=lf

# Unreal project descriptors and config (JSON / INI — always text)
*.uproject text eol=lf
*.uplugin  text eol=lf
*.ini      text eol=lf
*.cfg      text eol=lf
*.json     text eol=lf
*.xml      text eol=lf
*.plist    text eol=lf
*.entitlements text eol=lf

# Tooling, docs, data
*.sh       text eol=lf
*.py       text eol=lf diff=python
*.md       text eol=lf diff=markdown
*.txt      text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.toml     text eol=lf
*.csv      text eol=lf
*.editorconfig text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# Windows-only scripts MUST keep CRLF or cmd.exe mis-parses them.
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# Empty placeholder files
.gitkeep   text eol=lf

# ------------------------------------------------------------------------------
# Diff/merge behaviour for generated or noisy text
# ------------------------------------------------------------------------------
# Keep lock files out of code review diffs (still versioned, still merged).
*.lock     -diff
