# ------------------------------------------------------------------------------
# Fonts
# ------------------------------------------------------------------------------
*.ttf     filter=lfs diff=lfs merge=lfs -text
*.TTF     filter=lfs diff=lfs merge=lfs -text
*.otf     filter=lfs diff=lfs merge=lfs -text
*.OTF     filter=lfs diff=lfs merge=lfs -text
*.woff    filter=lfs diff=lfs merge=lfs -text
*.woff2   filter=lfs diff=lfs merge=lfs -text

# ------------------------------------------------------------------------------
# Binaries / libraries / debug symbols
# Binaries/ is gitignored, so these rules exist for deliberately versioned
# ThirdParty payloads under Source/ThirdParty and for prebuilt plugin binaries.
# ------------------------------------------------------------------------------
*.bin     filter=lfs diff=lfs merge=lfs -text
*.dll     filter=lfs diff=lfs merge=lfs -text
*.dylib   filter=lfs diff=lfs merge=lfs -text
*.so      filter=lfs diff=lfs merge=lfs -text
*.so.*    filter=lfs diff=lfs merge=lfs -text
*.lib     filter=lfs diff=lfs merge=lfs -text
*.a       filter=lfs diff=lfs merge=lfs -text
*.pdb     filter=lfs diff=lfs merge=lfs -text
*.PDB     filter=lfs diff=lfs merge=lfs -text
*.exe     filter=lfs diff=lfs merge=lfs -text
# Bundle directories: a pattern containing "/" is anchored to the repo root, so
# the leading "**/" is required to match a bundle at any depth.
**/*.app/**         filter=lfs diff=lfs merge=lfs -text
**/*.framework/**   filter=lfs diff=lfs merge=lfs -text
**/*.xcframework/** filter=lfs diff=lfs merge=lfs -text
**/*.dSYM/**        filter=lfs diff=lfs merge=lfs -text

# ------------------------------------------------------------------------------
# Archives
# ------------------------------------------------------------------------------
*.zip     filter=lfs diff=lfs merge=lfs -text
*.7z      filter=lfs diff=lfs merge=lfs -text
*.rar     filter=lfs diff=lfs merge=lfs -text
*.gz      filter=lfs diff=lfs merge=lfs -text
*.tgz     filter=lfs diff=lfs merge=lfs -text
*.bz2     filter=lfs diff=lfs merge=lfs -text
*.xz      filter=lfs diff=lfs merge=lfs -text

# ==============================================================================
# Text — explicit normalisation. Everything here is diffable and mergeable.
# ==============================================================================

# C++ / C# source and build scripts
*.h       text eol=lf diff=cpp
*.hpp     text eol=lf diff=cpp
*.inl     text eol=lf diff=cpp
*.c       text eol=lf diff=cpp
*.cc      text eol=lf diff=cpp
*.cpp     text eol=lf diff=cpp
*.cs      text eol=lf diff=csharp
*.usf     text eol=lf
*.ush     text eol=lf

# Unreal project descriptors and config (JSON / INI — always text)
*.uproject text eol=lf
*.uplugin  text eol=lf
*.ini      text eol=lf
*.cfg      text eol=lf
*.json     text eol=lf
*.xml      text eol=lf
*.plist    text eol=lf
*.entitlements text eol=lf

# Tooling, docs, data
*.sh       text eol=lf
*.py       text eol=lf diff=python
*.md       text eol=lf diff=markdown
*.txt      text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.toml     text eol=lf
*.csv      text eol=lf
*.editorconfig text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# Windows-only scripts MUST keep CRLF or cmd.exe mis-parses them.
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# Empty placeholder files
.gitkeep   text eol=lf

# ------------------------------------------------------------------------------
# Diff/merge behaviour for generated or noisy text
# ------------------------------------------------------------------------------
# Keep lock files out of code review diffs (still versioned, still merged).
*.lock     -diff

# ── Generated audition page ────────────────────────────────────────────────
# Art/Sounds/sound-test.html embeds every sound in the game as a base64 data URI
# so it plays with no server and no network. That makes it ~7 MB, and it is
# REGENERATED whenever the bank changes (Scripts/generate_sound_page.py) — so
# without this rule every regeneration would add another multi-megabyte blob to
# git history and to every clone, forever. Ordinary .html stays out of LFS; this
# one generated artefact does not.
Art/Sounds/sound-test.html filter=lfs diff=lfs merge=lfs -text
