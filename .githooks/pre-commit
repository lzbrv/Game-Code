#!/usr/bin/env sh
# ==============================================================================
# Trace - pre-commit hook: keep editor noise out of Config/*.ini history.
#
# Runs Scripts/config-hygiene.py --check, which fails on duplicate `+Key=Value`
# array entries. The Unreal editor re-appends those because it matches on the
# whole line rather than on the key, and once one is committed every teammate's
# editor has a fresh excuse to rewrite the file - which is what turns into
# "your local changes would be overwritten by merge" on their next pull.
#
# Installed by Scripts/setup-hooks.sh, which sets core.hooksPath. Hooks are NOT
# cloned with a repo, so a fresh clone must run that script once.
#
# Bypass with `git commit --no-verify` if you genuinely mean it.
# ==============================================================================
set -e

ROOT=$(git rev-parse --show-toplevel)

# Whether any Config/*.ini is staged. ONLY the config check below depends on this — it used to
# `exit 0` here, which meant a Source-only commit never reached the unity-hygiene check at the
# bottom, so the one Windows-build safety net a Mac can run was silently disarmed for exactly the
# commits that need it most.
CONFIG_STAGED=0
if git diff --cached --name-only --diff-filter=ACM | grep -qiE '^Config/.*\.ini$'; then
    CONFIG_STAGED=1
fi

# Pick a Python 3 that RUNS, not one that merely EXISTS on PATH.
#
# On a stock Windows 10/11 machine, Git Bash finds `python3` (and often `python`)
# in %LOCALAPPDATA%\Microsoft\WindowsApps. That is the Microsoft Store alias: it
# prints "Python was not found; run without arguments to install from the
# Microsoft Store..." and exits non-zero. Choosing by `command -v` alone picked
# it, and then every commit was refused with the unity-hygiene message below,
# blaming code for a missing interpreter. So each candidate has to execute a
# line of Python 3 first. `py -3` is the python.org launcher, which Windows
# installs even when neither name is on PATH. PY is deliberately left unquoted
# where it is used, so `py -3` splits into the command and its flag.
PY=""
for Candidate in python3 python "py -3"; do
    # shellcheck disable=SC2086
    if $Candidate -c 'import sys; sys.exit(0 if sys.version_info[0] >= 3 else 1)' >/dev/null 2>&1; then
        PY=$Candidate
        break
    fi
done
if [ -z "$PY" ]; then
    echo "pre-commit: no working Python 3 (tried python3, python, py -3)." >&2
    echo "pre-commit: SKIPPING the Config hygiene and unity-hygiene checks - this commit" >&2
    echo "            has NOT been checked for the Windows unity-build break." >&2
    echo "            On Windows: install Python 3 from python.org, or turn off the" >&2
    echo "            python/python3 'App execution aliases' in Windows Settings." >&2
    exit 0
fi

# shellcheck disable=SC2086
if [ "$CONFIG_STAGED" = "1" ] && ! $PY "$ROOT/Scripts/config-hygiene.py" --check; then
    echo
    echo "pre-commit: refusing the commit - Config/*.ini carries editor noise."
    echo "  Fix it:      $PY Scripts/config-hygiene.py --fix && git add Config"
    echo "  Or bypass:   git commit --no-verify"
    exit 1
fi

# ---- unity hygiene: the Windows-only break a Mac build usually cannot see ---
#
# A `using namespace` at file scope leaks into every file compiled after it in
# the same unity blob, and MSVC raises C4459 as an ERROR. clang on macOS reports
# it only when the two files share a blob on the Mac too, and the grouping
# differs between machines. That has broken the Windows build twice. This check
# is mechanical and runs on both machines, which is the part of the gap a Mac
# CAN close.
# shellcheck disable=SC2086
if ! $PY "$ROOT/Scripts/unity-hygiene.py"; then
    echo
    echo "pre-commit: refusing the commit - a new file-scope \`using namespace\` would"
    echo "            break the Windows build in a file nobody touched."
    echo "  Or bypass:   git commit --no-verify"
    exit 1
fi

exit 0
